<Window x:Class="HUCE_DALTUD_LOPNV90_2025_0218867.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HUCE_DALTUD_LOPNV90_2025_0218867"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="1000">
    <Window.Resources>
        <!-- Định nghĩa màu chủ đạo -->
        <SolidColorBrush x:Key="ChuDao" Color="#1976D2"/>
        <SolidColorBrush x:Key="ChuDao2" Color="#0D47A1"/>
        <SolidColorBrush x:Key="ChuDao4" Color="#2196F3"/>
        <!-- anh  -->
        <!-- Style cho Button viền bo -->
        <Style x:Key="OutlinedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource ChuDao}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <!--anh 123 -->
                
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho Button phẳng -->
        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <!-- Thanh trên + trái -->
        <Border Background="{StaticResource ChuDao4}" Margin="5" CornerRadius="10" Grid.Row="0" Grid.RowSpan="2"/>
        <Border Margin="5" CornerRadius="10" Grid.Row="2" Background="{StaticResource ChuDao4}"/>

        <!-- Thanh Recent projects -->
        <Border Grid.Column="1" Grid.Row="1" Background="{StaticResource ChuDao4}" Height="35" VerticalAlignment="Top" Margin="20 0 20 0">
            <TextBlock FontSize="16" FontWeight="Bold" Foreground="White"
                       Text="Recent projects" VerticalAlignment="Center" Margin="20 0 0 0"/>
        </Border>

        <!-- Logo -->
        <Image Source="/Resources/Anh/1200px-LOGO_DHXD.png" 
               Grid.RowSpan="2" VerticalAlignment="Top" Width="60" Height="60" Margin="0 20 0 0"/>

        <!-- Tiêu đề -->
        <TextBlock FontSize="22" FontWeight="Bold" Foreground="{StaticResource ChuDao2}"
                   Text="Phần mềm tính toán cột thép" 
                   HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1"/>

        <!-- Các nút bên trái -->
        <StackPanel VerticalAlignment="Top" Grid.Row="1" Margin="0 50 0 0">
            <Button
                Width="200" Height="40"
                Content="Tạo mới" 
                x:Name="btnTaoMoi"
                Style="{StaticResource OutlinedButtonStyle}"
                Click="btnTaoMoi_Click"/>
            <Button
                Width="200" Height="40"
                Content="Mở tài liệu"
                Style="{StaticResource OutlinedButtonStyle}"/>
        </StackPanel>

        <!-- Các nút dưới -->
        <StackPanel VerticalAlignment="Bottom" Grid.Row="2" Margin="0 0 0 20">
            <Button FontSize="14" Width="200" Height="30"
            Content="Trợ giúp"
            Background="#4CAF50" Foreground="White"
            BorderBrush="Transparent" Cursor="Hand"/>
            <Button FontSize="14" Width="200" Height="30"
            Content="Tiêu chuẩn Việt Nam"
            Background="#FF9800" Foreground="White"
            BorderBrush="Transparent" Cursor="Hand"/>
        </StackPanel>


        <!-- Thanh dưới bên phải -->
        <Border Grid.Column="1" Grid.Row="2" Background="{StaticResource ChuDao4}" Height="35" VerticalAlignment="Top" Margin="20 0 20 0"/>
    </Grid>
</Window>
