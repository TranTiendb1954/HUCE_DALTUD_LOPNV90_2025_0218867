<Page x:Class="DALTUDTXD.Pages.pageVatLieu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DALTUDTXD.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="565" d:DesignWidth="800"
      Title="VẬT LIỆU " Background="White">

    <Page.Resources>
        <!-- Màu sắc -->
        <SolidColorBrush x:Key="ColorPrimary" Color="#FF6A5ACD"/>
        <SolidColorBrush x:Key="ColorSecondary" Color="#FF2F2F4F"/>
        <SolidColorBrush x:Key="ColorDanger" Color="Black"/>
        <SolidColorBrush x:Key="ColorSuccess" Color="#FF228B22"/>

        <!-- Style button bo góc + chữ đậm -->
        <Style TargetType="Button" x:Key="RoundedButton">
            <Setter Property="Background" Value="{StaticResource ColorPrimary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF7B68EE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF5A4DCB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style DataGrid -->
        <Style TargetType="DataGrid" x:Key="MaterialDataGridStyle">
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F3F3F3"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="ColumnHeaderHeight" Value="35"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#DDD"/>
            <Setter Property="VerticalGridLinesBrush" Value="#DDD"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>

        <!-- Style TextBlock chữ đậm -->
        <Style TargetType="TextBlock" x:Key="BoldText">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Page.Resources>

    <Grid Margin="10">
        <!-- Tiêu đề -->
        <TextBlock Text="QUẢN LÝ VẬT LIỆU THÉP " FontSize="24" HorizontalAlignment="Center" Margin="0,10,0,20" Style="{StaticResource BoldText}"/>

        <!-- Khu vực nhập liệu -->
        <GroupBox Margin="0,60,0,0" VerticalAlignment="Top">
            <GroupBox.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="Thông số vật liệu"
                       FontWeight="Bold"
                       FontSize="16"
                       Foreground="{StaticResource ColorDanger}"/>
                </DataTemplate>
            </GroupBox.HeaderTemplate>

            <StackPanel Margin="10">
                <TextBlock Text="Tên vật liệu:" Margin="0,5,0,2" />
                <TextBox HorizontalAlignment="Left" Name="txtName" Width="269" Height="28"/>

                <TextBlock Text="Modul đàn hồi (E) [MPa]:" Margin="0,10,0,2" />
                <TextBox HorizontalAlignment="Left" Name="txtMoDunDanHoi" Width="269" Height="28"/>

                <TextBlock Text="Cường độ chịu kéo chảy (Fy) [MPa]:" Margin="0,10,0,2" />
                <TextBox HorizontalAlignment="Left" Name="txtCuongDoKeoChay" Width="269" Height="28"/>
            </StackPanel>
        </GroupBox>


        <!-- Khu vực button -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,240,10,0">
            <Button Name="SaveButton" Style="{StaticResource RoundedButton}" Content="Lưu vật liệu" Click="SaveButton_Click"/>
            <Button Name="EditButton" Style="{StaticResource RoundedButton}" Content="Sửa vật liệu" Background="{StaticResource ColorPrimary}" Click="EditButton_Click"/>
            <Button Name="DeleteButton" Style="{StaticResource RoundedButton}" Content="Xóa vật liệu" Background="{StaticResource ColorPrimary}" Click="DeleteButton_Click"/>
        </StackPanel>

        <!-- Khu vực hiển thị danh sách vật liệu -->
        <GroupBox Margin="0,300,0,0">
            <GroupBox.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="Danh sách vật liệu đã lưu"
                       FontWeight="Bold"
                       FontSize="16"
                       Foreground="{StaticResource ColorSecondary}"/>
                </DataTemplate>
            </GroupBox.HeaderTemplate>

            <DataGrid Name="MaterialDataGrid" AutoGenerateColumns="False" ItemsSource="{Binding clsVatLieu}" IsReadOnly="True"
              Style="{StaticResource MaterialDataGridStyle}" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" Margin="0,-10,0,-10">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="*"  Header="Tên" Binding="{Binding TenVatLieu}" />
                    <DataGridTextColumn Width="*" Header="Mô đun đàn hồi (E)" Binding="{Binding MoDunDanHoi}" />
                    <DataGridTextColumn Width="*" Header="Cường độ chịu kéo (Fy)" Binding="{Binding CuongDoChiuKeo}" />
                </DataGrid.Columns>
                
            </DataGrid>
        </GroupBox>

    </Grid>
       
</Page>
