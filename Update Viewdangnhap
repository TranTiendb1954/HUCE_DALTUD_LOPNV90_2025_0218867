<Window x:Class="DALTUDTXD.View.ViewDangNhap"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DALTUDTXD.View"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Đăng Nhập"
        Height="387"
        Width="350"
        Background="#F5F5F5"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <TextBlock
            Text="Đăng Nhập"
            HorizontalAlignment="Center"
            Margin="0 40 0 20"
            FontSize="32"
            FontWeight="Bold"
            Foreground="#3F51B5"/>

        <!-- Form -->
        <!-- Form -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top">

            <!-- Tên đăng nhập -->
            <StackPanel Orientation="Horizontal" Margin="0 10 0 0" VerticalAlignment="Center">
                <!-- Icon Account -->
                <materialDesign:PackIcon 
            Kind="Account" 
            Width="30" Height="30" 
            Margin="0 0 10 0" 
            VerticalAlignment="Center"
            Foreground="Black"/>

                <!-- TextBox username -->
                <TextBox
            Width="220"
            x:Name="txtUsername"
            materialDesign:HintAssist.Hint="Tên đăng nhập"
            materialDesign:HintAssist.HelperText="">
                    <TextBox.Text>
                        <Binding Path="Name" UpdateSourceTrigger="PropertyChanged"/>
                    </TextBox.Text>
                </TextBox>
            </StackPanel>

            <!-- Mật khẩu -->
            <StackPanel Orientation="Horizontal" Margin="0 10 0 0" VerticalAlignment="Center">
                <!-- Icon Lock -->
                <materialDesign:PackIcon 
            Kind="Lock" 
            Width="30" Height="30" 
            Margin="0 0 10 0" 
            VerticalAlignment="Center"
            Foreground="Black"/>

                <!-- Grid chứa PasswordBox/TextBox + Nút mắt -->
                <Grid Width="220">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Password ẩn -->
                    <PasswordBox
                x:Name="PasswordHidden"
                
                materialDesign:HintAssist.Hint="Mật khẩu"
                materialDesign:HintAssist.HelperText="Ít nhất 8 ký tự"
                materialDesign:TextFieldAssist.DecorationVisibility="Visible"
                Grid.Column="0"
                PasswordChanged="PasswordHidden_PasswordChanged"/>

                    <!-- Password hiện -->
                    <TextBox
                x:Name="PasswordVisible"
                Visibility="Collapsed"
                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                materialDesign:HintAssist.Hint="Mật khẩu"
                materialDesign:HintAssist.HelperText="Ít nhất 8 ký tự"
                Grid.Column="0"
                TextChanged="PasswordVisible_TextChanged"/>

                    <!-- Nút mắt -->
                    <Button
                Width="32" Height="32"
                Grid.Column="1"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                Click="TogglePassword_Click">
                        <materialDesign:PackIcon
                    x:Name="EyeIcon"
                    Kind="EyeOff"
                    Width="24"
                    Height="24"
                    Foreground="#666"/>
                    </Button>
                </Grid>
            </StackPanel>
        </StackPanel>

        <Button  Grid.Row="2"
            Content="Đăng nhập"
            Width="200"
            Height="45"
            FontSize="18"
            FontWeight="Bold"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Background="#3F51B5"
            Foreground="White"
            materialDesign:ButtonAssist.CornerRadius="20"
            Style="{StaticResource MaterialDesignRaisedButton}"
            />
        <!-- Các nút phụ -->
        <StackPanel Grid.Row="2" Margin="0 120 0 0" HorizontalAlignment="Center">

            <!-- Nút Đăng ký -->
            <Button
        Content="Đăng ký"
        Width="200"
        Height="40"
        Background="#3F51B5"
        Foreground="White"
        FontWeight="Bold"
        Margin="0 10 0 0"
        materialDesign:ButtonAssist.CornerRadius="20"
        Style="{StaticResource MaterialDesignRaisedButton}"/>

            <!-- Nút Thoát -->
            <Button
        Content="Thoát"
        Width="200"
        Height="40"
        Background="#EF5350"
        Foreground="White"
        FontWeight="Bold"
        Margin="0 10 0 0"
        materialDesign:ButtonAssist.CornerRadius="20"
        Style="{StaticResource MaterialDesignRaisedButton}"/>

            <!-- Nút Hiện/Ẩn mật khẩu -->
            
      
        </StackPanel>


    </Grid>
</Window>
