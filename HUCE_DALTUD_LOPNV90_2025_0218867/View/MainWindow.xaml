<Window x:Class="HUCE_DALTUD_LOPNV90_2025_0218867.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phần mềm tính toán cột thép chữ I"
        Height="700"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <!-- ================= LOCAL STYLE (KHÔNG KHAI BÁO MÀU) ================= -->
    <Window.Resources>

        <!-- Button bo góc – dùng màu từ App.xaml -->
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ChuDao3}"/>
            <Setter Property="Foreground" Value="{StaticResource ChuDao2}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                BorderThickness="0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ================= LAYOUT ================= -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <!-- Background trái -->
        <Border Grid.Row="0"
                Grid.RowSpan="3"
                Background="{StaticResource ChuDao4}"
                Margin="10"
                CornerRadius="10"/>

        <!-- Logo -->
        <Image Source="/Resources/Anh/1200px-LOGO_DHXD.png"
               Width="70"
               Height="60"
               Margin="20,0,0,0"
               VerticalAlignment="Center"
               HorizontalAlignment="Left"/>

        <!-- Tiêu đề -->
        <TextBlock Grid.Column="1"
                   Grid.Row="0"
                   Text="Phần mềm tính toán cột thép chữ I"
                   FontSize="30"
                   FontWeight="Bold"
                   Foreground="{StaticResource ChuDao2}"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>

        <!-- Ghi chú -->
        <Border Grid.Column="1"
                Grid.Row="1"
                Background="{StaticResource ChuDao4}"
                CornerRadius="10"
                Height="40"
                Margin="20,20,20,0">
            <TextBlock Text="Ghi chú"
                       Foreground="{StaticResource ChuDao2}"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>
        </Border>

        <!-- Menu trái -->
        <StackPanel Grid.Column="0"
                    Grid.Row="1"
                    
                    Margin="20,50,20,0"
                    VerticalAlignment="Top">

            <Button Content="Tính toán"
                    FontSize="14"
                    Style="{StaticResource RoundedButton}"
                    Click="btnTaoMoi_Click"/>

            <Button Content="Mở tài liệu"
                    FontSize="14"
                    Style="{StaticResource RoundedButton}"/>

            <Button Content="Xuất báo cáo"
                    FontSize="14"
                    Style="{StaticResource RoundedButton}"/>

            <Button Content="Cài đặt"
                    FontSize="14"
                    Style="{StaticResource RoundedButton}"/>
        </StackPanel>

        <!-- Hỗ trợ -->
        <StackPanel Grid.Column="0"
                    Grid.Row="2"
                    Margin="20"
                    VerticalAlignment="Bottom">

            <Button Content="Hỗ trợ"
                    FontSize="14"
                    Style="{StaticResource RoundedButton}"/>

            <Button Content="Tiêu chuẩn Việt Nam"
                    FontSize="14"
                    Style="{StaticResource RoundedButton}"/>
        </StackPanel>

        <!-- Nội dung chính -->
        <Border Grid.Column="1"
                Grid.Row="1"
                Margin="20,80,20,20"
                Background="{StaticResource ChuDao4}"
                CornerRadius="10">

            <RichTextBox Background="{StaticResource ChuDao4}"
                         Foreground="{StaticResource ChuDao2}"
                         FontWeight="Bold"
                         FontSize="14"
                         Margin="10"
                         BorderThickness="0"
                         VerticalScrollBarVisibility="Auto">

                <FlowDocument>
                    <Paragraph>
                        Chào mừng đến với phần mềm tính toán cột thép chữ I.
                    </Paragraph>
                    <Paragraph>
                        Bạn có thể chọn các chức năng bên trái để bắt đầu.
                    </Paragraph>
                </FlowDocument>

            </RichTextBox>
        </Border>

    </Grid>
</Window>
