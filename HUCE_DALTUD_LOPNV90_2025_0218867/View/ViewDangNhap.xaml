<Window x:Class="HUCE_DALTUD_LOPNV90_2025_0218867.View.ViewDangNhap"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HUCE_DALTUD_LOPNV90_2025_0218867.View"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Đăng Nhập"
        Height="460"
        Width="350"
        Background="#F5F5F5"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <TextBlock
            Text="Đăng Nhập"
            HorizontalAlignment="Center"
            Margin="0,30,0,20"
            FontSize="32"
            FontWeight="Bold"
            Foreground="{StaticResource ChuDao3}"/>

        <!-- Form -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center">

            <!-- Tên đăng nhập với Watermark -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                <TextBlock Text="👤" FontSize="24" Width="30" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Grid Width="220">
                    <TextBox x:Name="txtName" VerticalContentAlignment="Center" Padding="5"/>
                    <TextBlock Text="Tên đăng nhập"
                               Foreground="White"
                               IsHitTestVisible="False"
                               Margin="5,0,0,0"
                               VerticalAlignment="Center">  
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <!-- Hiển thị Watermark khi TextBox rỗng -->
                                    <DataTrigger Binding="{Binding Text, ElementName=txtName}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtName}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <!-- Ẩn Watermark khi có chữ -->
                                    <DataTrigger Binding="{Binding Text, ElementName=txtName}" Value="{x:Static sys:String.Empty}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                </Grid>
            </StackPanel>

            <!-- Mật khẩu -->
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0" VerticalAlignment="Center">
                <TextBlock Text="🔒" FontSize="24" Width="30" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <PasswordBox                    
                    Width="220"
                    x:Name="PasswordBox"
                    VerticalContentAlignment="Center"
                    Padding="5"
                    ToolTip="Ít nhất 8 ký tự"/>
            </StackPanel>

        </StackPanel>        

        <!-- Các nút phụ -->
        <StackPanel Grid.Row="2" Margin="0,30,0,0" HorizontalAlignment="Center">
            <!-- Nút đăng nhập -->
            <Button
                Grid.Row="2"
                Content="Đăng nhập"
                Width="200"
                Height="45"
                FontSize="18"
                FontWeight="Bold"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Background="{StaticResource ChuDao3}"
                Foreground="White"
                BorderBrush="{StaticResource ChuDao3}"
                Margin="0,20,0,0"
                Click="btnDangNhap_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="25" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Nút Đăng ký -->
            <Button
                Content="Đăng ký"
                Width="200"
                Height="45"
                FontSize="18"
                Background="{StaticResource ChuDao3}"
                Foreground="White"
                FontWeight="Bold"
                Margin="0,10,0,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="20" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Nút Thoát -->
            <Button
                Content="Thoát"
                Width="200"
                Height="45"
                FontSize="18"
                Background="{StaticResource ChuDao3}"
                Foreground="White"
                FontWeight="Bold"
                Margin="0,10,0,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="20" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>            
        </StackPanel>

    </Grid>
</Window>
