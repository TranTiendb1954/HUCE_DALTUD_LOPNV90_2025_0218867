<Window x:Class="HUCE_DALTUD_LOPNV90_2025_0218867.View.ViewDangNhap"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HUCE_DALTUD_LOPNV90_2025_0218867.View"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Đăng Nhập" Height="450" Width="350"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Màu chủ đạo -->
        <SolidColorBrush x:Key="ChuDao" Color="#1976D2"/>

        <!-- Style cho TextBox bo tròn -->
        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho PasswordBox -->
        <Style TargetType="PasswordBox" x:Key="RoundedPasswordBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho nút đăng nhập -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ChuDao}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Hiệu ứng hover -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1565C0"/>
                </Trigger>
                <!-- Khi nhấn -->
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0D47A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <TextBlock Margin="0 50 0 0" FontWeight="Bold" Foreground="{StaticResource ChuDao}" 
                   FontSize="30" HorizontalAlignment="Center" Text="Đăng Nhập"/>

        <!-- Nhập liệu -->
        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">

            <!-- Ô nhập username -->
            <Grid Width="250" Height="35" Margin="0 100 0 0">
                <TextBox x:Name="txtName" Style="{StaticResource RoundedTextBox}"/>
                <TextBlock Text="Tên đăng nhập" Foreground="Gray" Margin="8,0,0,0" 
                           VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <!-- Hiện khi Text rỗng -->
                                <DataTrigger Binding="{Binding Text, ElementName=txtName}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <!-- Ẩn khi có Text -->
                                <DataTrigger Binding="{Binding Text, ElementName=txtName}" Value="{x:Static sys:String.Empty}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Text, ElementName=txtName}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Text, ElementName=txtName}" Value=" ">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Ô nhập password -->
            <Grid Width="250" Height="35" Margin="0 30 0 0">
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource RoundedPasswordBox}"/>
                <TextBlock Text="Mật khẩu" Foreground="Gray" Margin="8,0,0,0" 
                           VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <!-- Hiện khi chưa nhập -->
                                <DataTrigger Binding="{Binding Password.Length, ElementName=PasswordBox}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <!-- Ẩn khi đã nhập -->
                                <DataTrigger Binding="{Binding Password.Length, ElementName=PasswordBox}" Value="1">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </StackPanel>

        <!-- Nút đăng nhập -->
        <Button Grid.Row="2" Width="200" Height="40"
                x:Name="btnDangNhap"
                Style="{StaticResource PrimaryButtonStyle}"
                Click="btnDangNhap_Click"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Content="Đăng nhập"/>

        <!-- Quên mật khẩu -->
        <Button Grid.Row="1" Width="150" Height="30"
                HorizontalAlignment="Right" Margin="0 0 20 0"
                Background="Transparent" BorderThickness="0"
                Foreground="Gray" Cursor="Hand"
                Content="Quên mật khẩu"/>
    </Grid>
    
</Window>
