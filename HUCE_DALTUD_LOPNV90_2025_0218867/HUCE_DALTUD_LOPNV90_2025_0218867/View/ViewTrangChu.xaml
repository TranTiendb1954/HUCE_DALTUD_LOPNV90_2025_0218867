<Window x:Class="HUCE_DALTUD_LOPNV90_2025_0218867.View.ViewTrangChu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HUCE_DALTUD_LOPNV90_2025_0218867.View"
        xmlns:ribbon="clr-namespace:System.Windows.Controls.Ribbon;assembly=System.Windows.Controls.Ribbon"
        mc:Ignorable="d"
        Title="ViewTrangChu" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="135"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Ribbon -->
        <ribbon:Ribbon x:Name="rbncontrol" Background="#1976D2" Foreground="White">

            <!-- Menu -->
            <ribbon:Ribbon.ApplicationMenu>
                <ribbon:RibbonApplicationMenu 
                        SmallImageSource="/Resources/Icons/Menu.png" 
                        Background="#1565C0">

                    <ribbon:RibbonApplicationMenuItem 
                        ImageSource="/Resources/Icons/User.png" 
                        Header="Tài khoản" Width="150"/>

                    <ribbon:RibbonApplicationMenuItem 
                        ImageSource="/Resources/Icons/Logout.png" 
                        Header="Đăng xuất" Width="150"/>

                    <ribbon:RibbonApplicationMenuItem 
                        ImageSource="/Resources/Icons/Settings.png" 
                        Header="Cài đặt" Width="150"/>

                </ribbon:RibbonApplicationMenu>
            </ribbon:Ribbon.ApplicationMenu>


            <!-- Tab 1 -->
            <ribbon:RibbonTab Header="Tiết diện" x:Name="tab_TietDien">
                <ribbon:RibbonGroup Header="Material">
                    <Button Height="60" x:Name="btnVatLieu" Click="btnVatLieu_Click">
                        <StackPanel>
                            <Image Source="/Resources/Anh/steel.jpg" Width="30"/>
                            <TextBlock Text="Material"/>
                        </StackPanel>
                    </Button>
                </ribbon:RibbonGroup>

                <ribbon:RibbonGroup Header="Thông số cột">
                    <Button Height="60" x:Name="btnThongSoCot" Click="btnThongSoCot_Click">
                        <StackPanel>
                            <Image Source="/Resources/Anh/5672201.png" Width="30"/>
                            <TextBlock Text="Column parameters"/>
                        </StackPanel>
                    </Button>
                    <Button Height="60" x:Name="btnTietDien" Click="btnTietDien_Click">
                        <StackPanel>
                            <Image Source="/Resources/Anh/i.png" Width="20"/>
                            <TextBlock Text="Sections"/>
                        </StackPanel>
                    </Button>
                </ribbon:RibbonGroup>
            </ribbon:RibbonTab>

            <!-- Tab 2 -->
            <ribbon:RibbonTab Header="Tính Toán" x:Name="tab_TinhToan">
                <ribbon:RibbonGroup Header="Tính toán">
                    <Button Height="60" x:Name="btnTinhToanKNCNLechTam" Click="btnTinhToanKNCNLechTam_Click">
                        <StackPanel>
                            <Image Source="/Resources/Anh/suc.jpg" Width="35" Height="35"/>
                            <TextBlock Text="KN chịu nén lệch tâm"/>
                        </StackPanel>
                    </Button>
                </ribbon:RibbonGroup>
            </ribbon:RibbonTab>

            <!-- Tab 3 -->
            <ribbon:RibbonTab Header="Báo cáo" x:Name="tab_BaoCao">
                <ribbon:RibbonGroup Header="Xuất kết quả">
                    <Button Height="60" x:Name="btnXuatExcel" Click="btnXuatExcel_Click">
                        <StackPanel>
                            <Image Source="/Resources/Icons/excel.png" Width="30" Height="30"/>
                            <TextBlock Text="Excel"/>
                        </StackPanel>
                    </Button>
                </ribbon:RibbonGroup>
            </ribbon:RibbonTab>
        </ribbon:Ribbon>

        <!-- Frame hiển thị nội dung -->
        <Frame x:Name="frame_Body" Grid.Row="1"/>
    </Grid>
</Window>
